{
  "expo": {
    "name": "CAS",
    "slug": "Prototipo",
    "backgroundColor": "#2e5b44",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-cas.png",
    "scheme": "prototipo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#80cba6",
        "foregroundImage": "./assets/images/logo-cas.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.jrmz2006.prototipo"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo-cas.png",
          "imageWidth": 400,
          "resizeMode": "contain",
          "backgroundColor": "#2e5b44",
          "dark": {
            "backgroundColor": "#1f402f"
          }
        }
      ],
      "expo-web-browser",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "46809437-134c-4d25-8007-a7eef34b019f"
      }
    }
  }
}
